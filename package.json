{
  "name": "jtorleon-studios-team.github.io",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --config config/dev.config.ts --no-open",
    "build": "docusaurus build --config config/dev.config.ts",
    "swizzle": "docusaurus swizzle --config config/dev.config.ts",
    "deploy": "docusaurus deploy --config config/dev.config.ts",
    "clear": "docusaurus clear --config config/dev.config.ts",
    "serve": "docusaurus serve --config config/dev.config.ts",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "check": "biome check --write",
    "tree": "find . -not -path '*/node_modules/*' -not -path '*/.git/*' | sort"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "braces": "^3.0.3",
    "serialize-javascript": "^7.0.5",
    "tinypool": "^2.1.2",
    "postcss-selector-parser": "^7.1.6",
    "uuid": "^11.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
