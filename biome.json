{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "plugins": [],
  "files": {
    "includes": ["**", "!dist", "!build", "!coverage", "!.github", "!.devcontainer"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "enabled": true
  },
  "html": {
    "experimentalFullSupportEnabled": false,
    "formatter": {
      "enabled": true,
      "attributePosition": "multiline",
      "selfCloseVoidElements": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": {
        "recommended": true
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "useForOf": "error",
        "noUselessElse": "error",
        "noParameterAssign": "error"
      },
      "complexity": {
        "noForEach": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": []
}
